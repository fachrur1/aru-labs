# ============================================================================
# .env.example — copy to .env and fill in your values. NEVER commit .env.
#
# Public site + admin dashboard read the VITE_* variables at BUILD time
# (Vite inlines them). The Supabase anon key is safe to expose — Row Level
# Security protects the data (see supabase/migrations/0002_rls.sql).
# ============================================================================

# --- Supabase project (Settings → API) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Migration / bootstrap / verify scripts (server-side only!) ---
# The service-role key bypasses RLS. Use ONLY in these local scripts,
# never in any frontend code and never commit it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by scripts/verify-cms.mjs to test the full admin flow
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=your-strong-password

# Public origin used to resolve relative image paths during migration
SITE_URL=https://fachrur.is-a.dev
