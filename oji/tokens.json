{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "An original illustrated sky-island world framing authentic graphic design and 3D artwork.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.067,
          0.067,
          0.063
        ],
        "hex": "#111110"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.929,
          0.918,
          0.89
        ],
        "hex": "#edeae3"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.302,
          0.122
        ],
        "hex": "#ff4d1f"
      }
    },
    "paper": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.969,
          0.953,
          0.914
        ],
        "hex": "#f7f3e9"
      }
    },
    "sky": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.663,
          0.851,
          0.906
        ],
        "hex": "#a9d9e7"
      }
    },
    "cyan": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.843,
          0.941,
          0.922
        ],
        "hex": "#d7f0eb"
      }
    },
    "yellow": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.957,
          0.847,
          0.522
        ],
        "hex": "#f4d885"
      }
    },
    "peach": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.945,
          0.725,
          0.616
        ],
        "hex": "#f1b99d"
      }
    },
    "green": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.314,
          0.424,
          0.333
        ],
        "hex": "#506c55"
      }
    },
    "lavender": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.765,
          0.741,
          0.847
        ],
        "hex": "#c3bdd8"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.157,
          0.322,
          0.224
        ],
        "hex": "#285239"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.639,
          0.161,
          0.125
        ],
        "hex": "#a32920"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "scene": {
      "$value": {
        "value": 120,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 6,
          "unit": "rem"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.06,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "editorial": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Instrument Serif",
        "fontSize": {
          "value": 3,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "metadata": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.06,
          "unit": "em"
        }
      }
    }
  }
}
