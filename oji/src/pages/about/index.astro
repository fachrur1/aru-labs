---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getProfile } from '../../lib/content';
import '../../styles/public-pages.css';
const profile = await getProfile();
---
<Base title="About — OJI / Muhammad Fachrurrozy" description="Meet Muhammad Fachrurrozy: Engineering Physics at Universitas Gadjah Mada, with a practice spanning 3D design, visualization, and renewable energy." canonical="https://oji.is-cool.dev/about/">
  <SiteHeader />
  <main id="main" class="support-page about-page">
    <header class="oji-shell page-intro about-intro"><div><p class="section-label">04 / Behind the work</p><h1 class="oji-display">A curious mind.<br /><span class="oji-editorial">Many ways to make.</span></h1><p class="about-intro__name">Muhammad Fachrurrozy <span class="oji-mono">/ OJI</span></p></div><figure class="about-portrait"><img src={profile.image} alt="Muhammad Fachrurrozy wearing a beige blazer in a university corridor." width="1100" height="1467" decoding="async" /><figcaption class="oji-mono">The person behind the pixels.</figcaption></figure></header>
    <section class="oji-shell about-story" aria-labelledby="about-heading"><p class="section-label">An introduction</p><div><h2 id="about-heading" class="oji-editorial">{profile.introduction}</h2><p>{profile.background}</p><p>This collection brings together event mascots, upcycled product concepts, and research visuals. Different subjects, connected by a habit of working between technical structure and visual expression.</p><a class="text-link" href="/work/">See how that takes shape <span aria-hidden="true">↗</span></a></div></section>
    <section class="oji-shell about-toolkit" aria-labelledby="toolkit-heading"><div><p class="section-label">The toolkit</p><h2 id="toolkit-heading" class="oji-editorial">Different tools.<br />Same curiosity.</h2></div><div><p>Tools used across design, modeling, and energy analysis. The relevant methods are credited on each project.</p><ul class="tool-list">{profile.tools.map(tool => <li>{tool}</li>)}</ul></div></section>
    <section class="oji-shell about-timeline" aria-labelledby="timeline-heading"><div class="about-timeline__intro"><p class="section-label">Learning & making</p><h2 id="timeline-heading" class="oji-editorial">A few chapters<br />along the way.</h2></div><ol>{profile.experience.map(item => <li><span class="oji-mono">{item.year}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></li>)}</ol></section>
  </main>
  <SiteFooter />
</Base>
