---
const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/portfolio/', label: 'Gallery' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="oji-shell site-header__inner">
    <a href="/" class="wordmark oji-display" aria-label="OJI — home">OJI<span aria-hidden="true">®</span></a>
    <span class="header-caption oji-mono">A little out of this world.</span>
    <nav aria-label="Primary"><ul class="site-nav">{nav.map(item => <li><a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>)}</ul></nav>
    <div class="header-actions"><button class="motion-toggle oji-mono" type="button" data-motion-toggle aria-pressed="true">Motion on</button><button class="menu-toggle" type="button" aria-haspopup="dialog" aria-controls="mobile-menu">Menu <span aria-hidden="true">＋</span></button></div>
  </div>
  <div class="reading-progress" aria-hidden="true"></div>
</header>
<dialog id="mobile-menu" class="mobile-menu">
  <div class="mobile-menu__top"><a href="/" class="oji-display" aria-label="OJI — home">OJI</a><button type="button" data-close-menu aria-label="Close navigation">Close ×</button></div>
  <p class="oji-mono">Choose your next stop</p>
  <nav aria-label="Mobile navigation"><a href="/">00 <span>Home</span></a>{nav.map((item,i) => <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>0{i+1} <span>{item.label}</span> ↗</a>)}<a href="/exhibition/">05 <span>3D exhibition</span> ↗</a></nav>
  <p class="oji-editorial">Good things happen<br />when you wander.</p>
</dialog>
<script>
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const opener = document.querySelector<HTMLButtonElement>('.menu-toggle');
  opener?.addEventListener('click', () => menu?.showModal());
  document.querySelector('[data-close-menu]')?.addEventListener('click', () => menu?.close());
  menu?.addEventListener('click', event => { if (event.target === menu) menu.close(); });
</script>
<style>
  .site-header{position:relative;z-index:40;padding-block:22px;border-bottom:1px solid var(--oji-rule);background:var(--oji-base)}
  .site-header__inner{display:flex;align-items:center;gap:32px;justify-content:space-between}.wordmark{font-size:34px;letter-spacing:-.08em;white-space:nowrap}.wordmark span{font:11px var(--font-mono);vertical-align:top;margin-left:5px;letter-spacing:0}.header-caption{font-size:10px;letter-spacing:.07em;margin-right:auto}.site-nav{display:flex;gap:30px;list-style:none;margin:0;padding:0}.site-nav a{display:block;min-height:44px;align-content:center;font-size:13px}.site-nav a:hover,.site-nav a[aria-current=page]{text-decoration:underline;text-decoration-color:var(--oji-accent);text-underline-offset:8px}.header-actions{display:flex;align-items:center;gap:12px}.motion-toggle{background:none;border:1px solid var(--oji-rule);border-radius:50px;font-size:10px;letter-spacing:0;padding:10px 14px;min-height:44px;cursor:pointer}.motion-toggle:disabled{cursor:default;color:var(--oji-ink-soft)}.menu-toggle{display:none;min-height:44px;padding:8px 12px;background:var(--oji-accent);border:1px solid var(--oji-ink);border-radius:30px;color:var(--oji-ink);font:inherit}.reading-progress{position:fixed;z-index:100;top:0;left:0;width:100%;height:3px;background:var(--oji-accent);transform:scaleX(var(--scroll-progress,0));transform-origin:left;pointer-events:none}
  .mobile-menu{width:min(100%,540px);height:100dvh;max-height:100dvh;max-width:100vw;border:0;padding:24px;background:var(--oji-paper);color:var(--oji-ink);margin:0 0 0 auto}.mobile-menu::backdrop{background:#11111088}.mobile-menu__top{display:flex;align-items:center;justify-content:space-between;margin-bottom:60px}.mobile-menu__top a{font-size:40px}.mobile-menu__top button{font:inherit;border:1px solid var(--oji-ink);border-radius:40px;padding:10px 16px;background:transparent;min-height:44px}.mobile-menu nav{margin-block:20px 45px}.mobile-menu nav a{display:flex;gap:18px;align-items:center;font:11px var(--font-mono);border-bottom:1px solid var(--oji-rule);padding-block:14px}.mobile-menu nav a span{font:600 clamp(27px,7vw,42px) var(--font-display);letter-spacing:-.04em;margin-right:auto}.mobile-menu>.oji-editorial{font-size:36px;line-height:1.05;color:var(--green)}
  @media(min-width:1025px){:global(body:has(.hero-world)) .site-header{position:absolute;top:0;left:0;width:100%;background:transparent;border-color:#11111022}}
  @media(max-width:1024px){.header-caption{display:none}.site-header__inner{gap:16px}.site-nav{gap:24px}}
  @media(max-width:767px){.site-header{padding-block:12px}.site-header__inner{gap:10px}.site-header nav{display:none}.header-actions{margin-left:auto}.menu-toggle{display:block}.wordmark{font-size:30px}.motion-toggle{font-size:9px;padding-inline:10px}}
</style>
